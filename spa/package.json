{
	"name": "ai-training",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/generate-manifest.js && vite dev",
		"build": "node scripts/generate-manifest.js && vite build && cp build/index.html build/404.html",
		"preview": "vite preview",
		"generate-manifest": "node scripts/generate-manifest.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/js-yaml": "^4.0.9",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"highlight.js": "^11.9.0",
		"js-yaml": "^4.1.0",
		"katex": "^0.16.0",
		"marked": "^12.0.0"
	}
}
